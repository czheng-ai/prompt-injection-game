# Prompt Injection Game Environment
# Copy this to .env and fill in your values

# LLM Mode: "mock" (free, pattern-matching) or "real" (uses OpenAI API)
LLM_MODE=mock

# OpenAI API Key (only needed if LLM_MODE=real)
OPENAI_API_KEY=sk-your-key-here

# Model to use (only for real mode)
LLM_MODEL=gpt-4o-mini

# Server port
PORT=3000

# Session secret (change this in production)
SESSION_SECRET=change-me-to-something-random
