# Prompt Injection Game Environment
# Copy this to .env and fill in your values

# LLM Mode: "mock" (free, pattern-matching) or "real" (uses OpenAI API)
LLM_MODE=mock

# OpenAI API Key (only needed if LLM_MODE=real)
OPENAI_API_KEY=sk-your-key-here

# Model to use (only for real mode)
LLM_MODEL=gpt-4o-mini

# PostgreSQL connection (Render auto-provides this when you link a PG instance)
# Leave blank for local dev to use JSON file fallback
DATABASE_URL=

# Server port
PORT=3000

# Session secret (change this in production)
SESSION_SECRET=change-me-to-something-random

# Bot Detection
BOT_DETECTION_ENABLED=true

# Bot Detection Bypass (for testing only!)
# Send this key in X-Bot-Bypass header to skip bot detection
BOT_DETECTION_BYPASS_KEY=flint-let-me-in-2024

# Google reCAPTCHA v3 (register at https://www.google.com/recaptcha)
RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_SITE_KEY_HERE
RECAPTCHA_SECRET_KEY=YOUR_RECAPTCHA_SECRET_KEY_HERE
